---
---

<section class="home-hero" aria-labelledby="hero-title">
  <div class="hero-media">
    <div id="homeHeroCarousel" class="carousel slide hero-carousel" data-bs-ride="carousel" data-bs-interval="6000">
      <div class="carousel-indicators">
        <button type="button" data-bs-target="#homeHeroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Show Ghana Day banner"></button>
        <button type="button" data-bs-target="#homeHeroCarousel" data-bs-slide-to="1" aria-label="Show Black Star Square image"></button>
        <button type="button" data-bs-target="#homeHeroCarousel" data-bs-slide-to="2" aria-label="Show Kwame Nkrumah Memorial Park image"></button>
        <button type="button" data-bs-target="#homeHeroCarousel" data-bs-slide-to="3" aria-label="Show Flagstaff House image"></button>
      </div>

      <div class="carousel-inner">
        <div class="carousel-item active">
          <img
            src="/images/Banner.jpeg"
            alt="Ghana Day in Tampa Bay celebration banner featuring Ghanaian and Tampa Bay landmarks"
            width="1600"
            height="511"
            class="hero-image hero-image--banner"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <div class="carousel-item">
          <img
            src="/images/gallery/hero-carousel-black-star-square-ai-4800x1400.webp"
            alt="Black Star Square in Accra"
            width="4800"
            height="1400"
            class="hero-image"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="carousel-item">
          <img
            src="/images/hero/nkrumah-park-hero.webp"
            alt="Kwame Nkrumah Memorial Park with the independence monument, reflecting pool and horn-player sculptures"
            width="2048"
            height="597"
            class="hero-image"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="carousel-item">
          <img
            src="/images/hero-carousel-flagstaff-house-ai-4800x1400.webp"
            alt="Flagstaff House in Accra"
            width="4800"
            height="1400"
            class="hero-image"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <button class="carousel-control-prev" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="prev" aria-label="Previous home image">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="next" aria-label="Next home image">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
      </button>
    </div>

    <!-- Floating Content Panel (Desktop: positioned over right side; Mobile/Tablet: below image) -->
    <div id="homeHeroContentPanel" class="hero-content-panel hero-content--right">
      <p class="hero-eyebrow">GHANA DAY IN TAMPA BAY</p>
      <h1 id="hero-title" class="hero-heading">
        Celebrating Ghana<br />in Tampa Bay
      </h1>
      <p class="hero-description">
        A vibrant celebration of Ghanaian culture, community, music, food and heritage.
      </p>
      <div class="hero-actions">
        <a href="#getting-there" class="btn btn-hero-tickets">
          GETTING THERE
        </a>
        <a href="#event" class="btn btn-hero-explore">
          EXPLORE THE FESTIVAL
        </a>
      </div>
    </div>
  </div>

  <!-- Event Information Strip -->
  <aside class="hero-info-strip" aria-label="Event summary">
    <div class="header-container">
      <div class="row g-0 align-items-center">
        <!-- When / Time -->
        <div class="col-12 col-md-6 col-lg-3 info-col">
          <div class="info-item">
            <i class="bi bi-calendar-event info-icon" aria-hidden="true"></i>
            <div class="info-text">
              <span class="info-label">WHEN</span>
              <span class="info-value">Saturday, November 7, 2026</span>
              <span class="info-subvalue">10:00 AM</span>
            </div>
          </div>
        </div>

        <!-- Where / Location -->
        <div class="col-12 col-md-6 col-lg-3 info-col">
          <div class="info-item">
            <i class="bi bi-geo-alt-fill info-icon" aria-hidden="true"></i>
            <div class="info-text">
              <span class="info-label">WHERE</span>
              <span class="info-value">Rowlett Park</span>
              <span class="info-subvalue">2401 E Yukon Street, Tampa, FL</span>
            </div>
          </div>
        </div>

        <!-- Experience -->
        <div class="col-12 col-md-6 col-lg-3 info-col">
          <div class="info-item">
            <i class="bi bi-people info-icon" aria-hidden="true"></i>
            <div class="info-text">
              <span class="info-label">EXPERIENCE</span>
              <span class="info-value">Culture &bull; Food &bull; Music</span>
              <span class="info-subvalue">Ghana Day Celebration</span>
            </div>
          </div>
        </div>

        <!-- Event Countdown -->
        <div class="col-12 col-md-6 col-lg-3 info-col info-col-cta">
          <div
            class="event-countdown"
            data-event-date="2026-11-07T10:00:00-05:00"
          >
            <div class="event-countdown__heading">
              <span class="event-countdown__accent"></span>
              <span data-countdown-heading>EVENT STARTS IN</span>
            </div>

            <div class="event-countdown__units">
              <div class="event-countdown__unit">
                <span class="event-countdown__value" data-countdown-days aria-hidden="true">000</span>
                <span class="event-countdown__label">DAYS</span>
              </div>
              <span class="event-countdown__divider" aria-hidden="true"></span>
              <div class="event-countdown__unit">
                <span class="event-countdown__value" data-countdown-hours aria-hidden="true">00</span>
                <span class="event-countdown__label">HOURS</span>
              </div>
              <span class="event-countdown__divider" aria-hidden="true"></span>
              <div class="event-countdown__unit">
                <span class="event-countdown__value" data-countdown-minutes aria-hidden="true">00</span>
                <span class="event-countdown__label">MINUTES</span>
              </div>
              <span class="event-countdown__divider" aria-hidden="true"></span>
              <div class="event-countdown__unit event-countdown__unit--seconds">
                <span class="event-countdown__value" data-countdown-seconds aria-hidden="true">00</span>
                <span class="event-countdown__label">SECONDS</span>
              </div>
            </div>

            <p class="visually-hidden" data-countdown-accessible aria-live="polite"></p>
          </div>
        </div>
      </div>
    </div>
  </aside>
</section>

<script>
  const heroCarousel = document.querySelector<HTMLElement>('#homeHeroCarousel');
  const heroContentPanel = document.querySelector<HTMLElement>('#homeHeroContentPanel');

  if (heroCarousel && heroContentPanel) {
    const mobileContentQuery = window.matchMedia('(max-width: 991.98px)');

    const syncHeroContent = () => {
      const activeSlide = heroCarousel.querySelector<HTMLElement>('.carousel-item.active');
      const activeImage = activeSlide?.querySelector('img')?.getAttribute('src');
      const isBannerSlide = activeImage === '/images/Banner.jpeg';
      const hidePanel = isBannerSlide && !mobileContentQuery.matches;
      heroContentPanel.hidden = hidePanel;
      heroContentPanel.setAttribute('aria-hidden', String(hidePanel));
    };

    syncHeroContent();
    heroCarousel.addEventListener('slid.bs.carousel', syncHeroContent);
    mobileContentQuery.addEventListener('change', syncHeroContent);
  }

  const countdown = document.querySelector<HTMLElement>('[data-event-date]');

  if (countdown) {
    const EVENT_DATE = '2026-11-07T10:00:00-05:00';
    const eventDate = new Date(EVENT_DATE);
    const heading = countdown.querySelector<HTMLElement>('[data-countdown-heading]');
    const accessible = countdown.querySelector<HTMLElement>('[data-countdown-accessible]');
    const values = {
      days: countdown.querySelector<HTMLElement>('[data-countdown-days]'),
      hours: countdown.querySelector<HTMLElement>('[data-countdown-hours]'),
      minutes: countdown.querySelector<HTMLElement>('[data-countdown-minutes]'),
      seconds: countdown.querySelector<HTMLElement>('[data-countdown-seconds]'),
    };
    let previousValues: Record<string, string> | null = null;
    let lastAnnouncedMinute = -1;

    const formatDays = (value: number) => String(value).padStart(3, '0');
    const formatUnit = (value: number) => String(value).padStart(2, '0');

    const updateCountdown = () => {
      const totalSeconds = Math.max(0, Math.floor((eventDate.getTime() - Date.now()) / 1000));
      const nextValues = {
        days: formatDays(Math.floor(totalSeconds / 86400)),
        hours: formatUnit(Math.floor((totalSeconds % 86400) / 3600)),
        minutes: formatUnit(Math.floor((totalSeconds % 3600) / 60)),
        seconds: formatUnit(totalSeconds % 60),
      };

      Object.entries(nextValues).forEach(([key, value]) => {
        const element = values[key as keyof typeof values];
        if (!element) return;
        if (previousValues && previousValues[key] !== value) {
          element.classList.remove('is-changing');
          void element.offsetWidth;
          element.classList.add('is-changing');
          window.setTimeout(() => element.classList.remove('is-changing'), 320);
        }
        element.textContent = value;
      });

      const currentMinute = Math.floor(totalSeconds / 60);
      if (accessible && currentMinute !== lastAnnouncedMinute) {
        accessible.textContent = `${Number(nextValues.days)} days, ${Number(nextValues.hours)} hours and ${Number(nextValues.minutes)} minutes until Ghana Day`;
        lastAnnouncedMinute = currentMinute;
      }

      previousValues = nextValues;
      if (totalSeconds === 0) {
        if (heading) heading.textContent = 'THE CELEBRATION IS HERE';
        return false;
      }
      return true;
    };

    updateCountdown();
    const countdownInterval = window.setInterval(() => {
      if (!updateCountdown()) window.clearInterval(countdownInterval);
    }, 1000);
  }
</script>
