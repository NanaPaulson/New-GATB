---
const galleryItems = [
  {
    src: '/images/Photo1.png',
    category: 'Tradition & Heritage',
    alt: 'Three community members wearing Ghanaian traditional attire at a cultural celebration',
    caption: 'Ghanaian tradition expressed through ceremonial attire.',
    position: 'center 30%',
  },
  {
    src: '/images/photo2.png',
    category: 'Celebration & Unity',
    alt: 'Community leaders cutting a Ghana-themed celebration cake',
    caption: 'Community leaders celebrating Ghanaian culture and unity.',
    position: 'center 40%',
  },
  {
    src: '/images/Photo3.png',
    category: 'Community Connections',
    alt: 'Ghanaian community members gathered for a group photograph',
    caption: 'Members of the Ghanaian community gathering together.',
    position: 'center center',
  },
  {
    src: '/images/Photo4.jpeg',
    category: 'Ghanaian Heritage',
    alt: 'A visitor standing in front of the Black Star monument in Accra, Ghana',
    caption: 'Connecting with Ghana\'s national heritage and landmarks.',
    position: 'center 35%',
  },
  {
    src: '/images/Photo5.jpeg',
    category: 'Northern Heritage',
    alt: 'A woman wearing a traditional black-and-white Ghanaian smock at a cultural event',
    caption: 'Traditional Ghanaian smock and cultural craftsmanship.',
    position: 'center 25%',
  },
  {
    src: '/images/photo6.jpeg',
    category: 'Culture & Style',
    alt: 'Three men wearing Ghanaian traditional smocks outdoors',
    caption: 'Ghanaian traditional smocks worn with pride.',
    position: 'center 35%',
  },
];
---

<section id="gallery" class="gallery-experience" aria-labelledby="gallery-title">
  <div class="gallery-experience__container">
    <header class="gallery-experience__header text-center">
      <p class="gallery-experience__eyebrow">OUR GALLERY</p>
      <h2 id="gallery-title" class="gallery-experience__title">Moments That Bring Us Together</h2>
      <p class="gallery-experience__intro">
        Explore the people, culture and experiences that make Ghana Day in Tampa Bay unforgettable.
      </p>
    </header>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 gallery-experience__grid">
      {galleryItems.slice(0, 6).map((item, index) => (
        <div class="col">
          <button
            type="button"
            class="gallery-card"
            data-gallery-index={index}
            aria-label={`Open ${item.category}: ${item.caption}`}
          >
            <span class="gallery-card__media">
              <img
                src={item.src}
                alt={item.alt}
                loading="lazy"
                decoding="async"
                style={`object-position: ${item.position}`}
                class="gallery-card__image"
              />
              <span class="gallery-card__overlay">
                <span class="gallery-card__category">{item.category}</span>
                <span class="gallery-card__expand" aria-hidden="true"><i class="bi bi-arrows-fullscreen"></i></span>
              </span>
            </span>
          </button>
        </div>
      ))}
    </div>

    {galleryItems.length > 6 && (
      <div class="gallery-experience__more text-center">
        <button type="button" class="btn gallery-experience__more-button" data-gallery-more>VIEW MORE PHOTOS</button>
      </div>
    )}
  </div>

  <div class="modal fade gallery-lightbox" id="galleryLightbox" tabindex="-1" aria-labelledby="galleryLightboxTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
      <div class="modal-content gallery-lightbox__content">
        <div class="modal-header gallery-lightbox__header">
          <h2 id="galleryLightboxTitle" class="visually-hidden">Gallery image viewer</h2>
          <button type="button" class="btn-close gallery-lightbox__close" data-gallery-close aria-label="Close gallery"></button>
        </div>
        <div class="modal-body gallery-lightbox__body">
          <button type="button" class="gallery-lightbox__control gallery-lightbox__control--previous" data-gallery-previous aria-label="Previous photograph"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
          <figure class="gallery-lightbox__figure">
            <img class="gallery-lightbox__image" data-gallery-image alt="" />
            <figcaption class="gallery-lightbox__caption" data-gallery-caption></figcaption>
          </figure>
          <button type="button" class="gallery-lightbox__control gallery-lightbox__control--next" data-gallery-next aria-label="Next photograph"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
        </div>
        <div class="modal-footer gallery-lightbox__footer">
          <span data-gallery-counter>1 of 6</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const gallery = document.querySelector<HTMLElement>('#gallery');

  if (gallery) {
    const items = [
      { src: '/images/Photo1.png', alt: 'Three community members wearing Ghanaian traditional attire at a cultural celebration', caption: 'Ghanaian tradition expressed through ceremonial attire.' },
      { src: '/images/photo2.png', alt: 'Community leaders cutting a Ghana-themed celebration cake', caption: 'Community leaders celebrating Ghanaian culture and unity.' },
      { src: '/images/Photo3.png', alt: 'Ghanaian community members gathered for a group photograph', caption: 'Members of the Ghanaian community gathering together.' },
      { src: '/images/Photo4.jpeg', alt: 'A visitor standing in front of the Black Star monument in Accra, Ghana', caption: "Connecting with Ghana's national heritage and landmarks." },
      { src: '/images/Photo5.jpeg', alt: 'A woman wearing a traditional black-and-white Ghanaian smock at a cultural event', caption: 'Traditional Ghanaian smock and cultural craftsmanship.' },
      { src: '/images/photo6.jpeg', alt: 'Three men wearing Ghanaian traditional smocks outdoors', caption: 'Ghanaian traditional smocks worn with pride.' },
    ];
    const modal = gallery.querySelector<HTMLElement>('#galleryLightbox');
    const modalImage = gallery.querySelector<HTMLImageElement>('[data-gallery-image]');
    const caption = gallery.querySelector<HTMLElement>('[data-gallery-caption]');
    const counter = gallery.querySelector<HTMLElement>('[data-gallery-counter]');
    const closeButton = gallery.querySelector<HTMLButtonElement>('[data-gallery-close]');
    const previousButton = gallery.querySelector<HTMLButtonElement>('[data-gallery-previous]');
    const nextButton = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeIndex = 0;
    let lastFocused: HTMLElement | null = null;

    const render = () => {
      const item = items[activeIndex];
      if (!item || !modalImage || !caption || !counter) return;
      modalImage.src = item.src;
      modalImage.alt = item.alt;
      caption.textContent = item.caption;
      counter.textContent = `${activeIndex + 1} of ${items.length}`;
    };

    const close = () => {
      if (!modal) return;
      modal.classList.remove('show');
      modal.setAttribute('aria-hidden', 'true');
      modal.removeAttribute('role');
      document.body.classList.remove('modal-open');
      document.body.style.removeProperty('padding-right');
      lastFocused?.focus();
    };

    const open = (index: number) => {
      if (!modal) return;
      activeIndex = index;
      lastFocused = document.activeElement as HTMLElement;
      render();
      modal.classList.add('show');
      modal.setAttribute('aria-hidden', 'false');
      modal.setAttribute('role', 'dialog');
      document.body.classList.add('modal-open');
      window.setTimeout(() => closeButton?.focus(), reducedMotion ? 0 : 120);
    };

    gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-index]').forEach((button) => {
      button.addEventListener('click', () => open(Number(button.dataset.galleryIndex)));
    });
    closeButton?.addEventListener('click', close);
    previousButton?.addEventListener('click', () => { activeIndex = (activeIndex - 1 + items.length) % items.length; render(); });
    nextButton?.addEventListener('click', () => { activeIndex = (activeIndex + 1) % items.length; render(); });
    modal?.addEventListener('click', (event) => { if (event.target === modal) close(); });
    document.addEventListener('keydown', (event) => {
      if (!modal?.classList.contains('show')) return;
      if (event.key === 'Escape') close();
      if (event.key === 'ArrowLeft') { event.preventDefault(); activeIndex = (activeIndex - 1 + items.length) % items.length; render(); }
      if (event.key === 'ArrowRight') { event.preventDefault(); activeIndex = (activeIndex + 1) % items.length; render(); }
    });

    if (!reducedMotion) {
      const observer = new IntersectionObserver((entries, currentObserver) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            currentObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      gallery.querySelectorAll('.gallery-card').forEach((card) => {
        card.classList.add('gallery-card--reveal');
        observer.observe(card);
      });
    }
  }
</script>

<style>
  .gallery-experience { --gallery-background: #fafbf8; --gallery-green: #0b4f2e; --gallery-green-secondary: #217346; --gallery-sage: #e7f0e8; --gallery-text: #26332c; --gallery-gold: #c89b32; background: var(--gallery-background); border-bottom: 1px solid var(--gallery-sage); padding: clamp(5rem, 7vw, 7.5rem) 0; }
  .gallery-experience__container { margin-inline: auto; width: min(calc(100% - 3rem), 1400px); }.gallery-experience__header { margin: 0 auto 3.5rem; max-width: 780px; }.gallery-experience__eyebrow { color: var(--gallery-gold); font-size: .76rem; font-weight: 800; letter-spacing: .16em; margin: 0 0 1rem; }.gallery-experience__title { color: var(--gallery-green); font-family: Georgia, Cambria, 'Times New Roman', serif; font-size: clamp(2.4rem, 5vw, 4.6rem); line-height: 1.05; margin: 0; }.gallery-experience__intro { color: var(--gallery-text); font-size: 1.05rem; line-height: 1.65; margin: 1.15rem auto 0; max-width: 720px; }
  .gallery-card { background: transparent; border: 0; border-radius: .55rem; color: inherit; cursor: pointer; display: block; padding: 0; text-align: left; width: 100%; }.gallery-card:focus-visible { outline: 3px solid var(--gallery-gold); outline-offset: 5px; }.gallery-card__media { aspect-ratio: 4 / 3; background: var(--gallery-sage); border: 1px solid var(--gallery-sage); border-radius: .55rem; display: block; overflow: hidden; position: relative; }.gallery-card__image { display: block; height: 100%; object-fit: cover; transition: transform 250ms ease; width: 100%; }.gallery-card__overlay { background: linear-gradient(180deg, transparent 35%, rgba(11, 79, 46, .9) 100%); bottom: 0; color: white; display: flex; inset: 0; align-items: flex-end; justify-content: space-between; padding: 1rem; position: absolute; }.gallery-card__category { font-size: .82rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }.gallery-card__expand { align-items: center; background: rgba(255, 255, 255, .12); border: 1px solid rgba(255, 255, 255, .75); border-radius: 50%; display: inline-flex; height: 2.4rem; justify-content: center; opacity: .75; transition: opacity 220ms ease, background-color 220ms ease; width: 2.4rem; }.gallery-card:hover .gallery-card__image, .gallery-card:focus-visible .gallery-card__image { transform: scale(1.03); }.gallery-card:hover .gallery-card__expand, .gallery-card:focus-visible .gallery-card__expand { background: var(--gallery-green-secondary); opacity: 1; }
  .gallery-card--reveal { opacity: 0; transform: translateY(1rem); transition: opacity 500ms ease, transform 500ms ease; }.gallery-card--reveal.is-visible { opacity: 1; transform: translateY(0); }.gallery-experience__more { padding-top: 2.5rem; }.gallery-experience__more-button { background: var(--gallery-green); border: 1px solid var(--gallery-green); color: white; font-weight: 700; letter-spacing: .08em; }.gallery-experience__more-button:hover, .gallery-experience__more-button:focus-visible { background: var(--gallery-green-secondary); border-color: var(--gallery-green-secondary); color: white; }
  .gallery-lightbox { background: rgba(4, 31, 19, .88); }.gallery-lightbox.show { display: block; }.gallery-lightbox__content { background: transparent; border: 0; }.gallery-lightbox__header, .gallery-lightbox__footer { border: 0; }.gallery-lightbox__header { justify-content: flex-end; padding: .75rem; }.gallery-lightbox__close { filter: invert(1); opacity: 1; }.gallery-lightbox__body { align-items: center; display: flex; gap: 1rem; justify-content: center; padding: 0 1rem; }.gallery-lightbox__figure { margin: 0; max-width: min(82vw, 1100px); text-align: center; }.gallery-lightbox__image { display: block; height: min(72vh, 760px); max-width: 100%; object-fit: contain; width: auto; }.gallery-lightbox__caption { color: white; font-size: 1rem; margin-top: .8rem; }.gallery-lightbox__footer { color: white; justify-content: center; padding-top: .75rem; }.gallery-lightbox__control { align-items: center; background: rgba(255, 255, 255, .14); border: 1px solid rgba(255, 255, 255, .65); border-radius: 50%; color: white; display: inline-flex; flex: 0 0 auto; font-size: 1.6rem; height: 3.25rem; justify-content: center; width: 3.25rem; }.gallery-lightbox__control:hover, .gallery-lightbox__control:focus-visible { background: var(--gallery-green-secondary); color: white; }.gallery-lightbox__control:focus-visible, .gallery-lightbox__close:focus-visible { outline: 3px solid var(--gallery-gold); outline-offset: 3px; }
  @media (max-width: 767.98px) { .gallery-experience__container { width: calc(100% - 2rem); }.gallery-experience__header { margin-bottom: 2.75rem; }.gallery-lightbox__body { gap: .35rem; padding-inline: .35rem; }.gallery-lightbox__control { height: 2.75rem; width: 2.75rem; }.gallery-lightbox__image { height: 65vh; }.gallery-lightbox__caption { font-size: .9rem; } }
  @media (prefers-reduced-motion: reduce) { .gallery-card, .gallery-card__image, .gallery-card__expand { transition: none !important; }.gallery-card--reveal { opacity: 1; transform: none; } }
</style>
