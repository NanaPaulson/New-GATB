---
const programItems = [
  { number: '01', title: 'Opening Prayer' },
  { number: '02', title: 'National Anthem — USA and Ghana' },
  { number: '03', title: 'Opening Remarks by the President' },
  { number: '04', title: 'Purpose of the Gathering — MC' },
  { number: '05', title: 'Musical Interlude' },
  { number: '06', title: 'Introduction of Traditional Groups (as they come)' },
  { number: '07', title: 'Cultural Performance — USF-ASA Dance Group' },
  { number: '08', title: 'Cultural Performance — Traditional Groups' },
  { number: '09', title: 'Cultural Performance — Fethiou Thiossane Cultural Arts' },
  { number: '10', title: 'Musical Interlude' },
  { number: '11', title: 'Cultural Performance — Traditional Groups' },
  { number: '12', title: 'Goodwill Messages' },
  { number: '13', title: 'Jollof War' },
  { number: '14', title: 'Cultural Performance — Fethiou Thiossane Cultural Arts' },
  { number: '15', title: 'Cultural Performance — Traditional Groups' },
  { number: '16', title: 'Musical Interlude' },
  { number: '17', title: 'Closing Remarks' },
];
---

<section id="event" class="experience-section event-section" aria-labelledby="event-heading">
  <div class="header-container">
    <div class="row g-4 g-lg-5 align-items-center">
      <div class="col-12 col-lg-5 order-1">
        <div class="event-content">
          <p class="section-eyebrow reveal reveal-up">THE EVENT</p>
          <h2 id="event-heading" class="section-heading reveal reveal-up">
            A Day of Culture, Connection &amp; Celebration
          </h2>
          <p class="event-description reveal reveal-up">
            Ghana Day In Tampa Bay brings Ghanaian music, food, fashion, history and community together for a vibrant festival that educates, inspires and creates lasting connections in the heart of Tampa Bay.
          </p>
          <div class="event-actions reveal reveal-up">
            <a href="#getting-there" class="btn ticket-button">GETTING THERE</a>
            <a href="#festival-program" class="btn event-secondary-button">VIEW PROGRAM</a>
          </div>
        </div>
      </div>

      <div class="col-12 col-lg-7 order-2">
        <div class="event-image-wrapper">
          <img
            src="/images/gallery/welcome-carousel-ghanaian-drummers-2560x1440.webp"
            alt="Ghanaian traditional drummers and cultural performers celebrating at Ghana Day festival"
            width="1280"
            height="720"
            class="event-image"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<section id="festival-program" class="festival-program-section" aria-labelledby="festival-program-heading">
  <div class="header-container">
    <header class="festival-program-header text-center">
      <p class="section-eyebrow reveal reveal-up">FESTIVAL PROGRAM</p>
      <h2 id="festival-program-heading" class="section-heading reveal reveal-up">Experience the Day</h2>
      <p class="festival-program-intro reveal reveal-up">
        Saturday, November 7, 2026 <span aria-hidden="true">|</span> 10:00 AM–5:30 PM
      </p>
      <p class="festival-program-location reveal reveal-up">
        Rowlett Park <span aria-hidden="true">·</span> 2401 E. Yukon Street <span aria-hidden="true">·</span> Tampa, FL 33604
      </p>
    </header>

    <ol class="program-list stagger-group">
      {
        programItems.map((item) => (
          <li class="program-item">
            <span class="program-item__number" aria-hidden="true">{item.number}</span>
            <div class="program-item__content">
              <h3 class="program-item__title">{item.title}</h3>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="festival-program-note">Program sequence may be adjusted by the organizers.</p>
  </div>
</section>

<section class="event-final-cta" aria-labelledby="event-final-cta-heading">
  <div class="header-container text-center">
    <h2 id="event-final-cta-heading" class="event-final-cta__heading">Ready to Celebrate With Us?</h2>
    <p class="event-final-cta__description">
      Be part of a vibrant day of culture, community and lasting connections.
    </p>
    <div class="event-actions event-final-cta__actions">
      <a href="#site-footer" class="btn event-secondary-button">BECOME A VOLUNTEER</a>
    </div>
  </div>
</section>
