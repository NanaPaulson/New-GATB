---
const fashionItems = [
  {
    title: 'Royal Kente',
    caption: 'Ceremonial Heritage',
    image: '/images/royal-kente.png',
    alt: 'Ghanaian man wearing traditional royal kente cloth',
  },
  {
    title: 'Kaba & Slit',
    caption: 'Traditional Elegance',
    image: '/images/kaba-and-slit.png',
    alt: 'Ghanaian woman wearing a white lace kaba blouse and traditional slit skirt',
  },
  {
    title: 'Northern Smock',
    caption: 'Northern Craftsmanship',
    image: '/images/northern-smock.png',
    alt: 'Ghanaian man wearing a traditional Northern smock and woven cap',
  },
  {
    title: 'Modern Ghanaian Style',
    caption: 'Contemporary Design',
    image: '/images/modern-ghanaian-style.png',
    alt: 'Ghanaian woman wearing a contemporary Ankara evening dress',
  },
];
---

<section id="fashion" class="experience-section fashion-section" aria-labelledby="fashion-heading">
  <div class="header-container">
    <header class="fashion-header text-center">
      <p class="section-eyebrow reveal reveal-up">FASHION &amp; HERITAGE</p>
      <h2 id="fashion-heading" class="section-heading reveal reveal-up">Wear the Culture: Fashion with Heritage</h2>
      <p class="fashion-intro reveal reveal-up">
        Discover the artistry, identity and stories expressed through Ghana’s traditional clothing.
      </p>
    </header>

    <div class="row g-3 g-lg-4 fashion-grid stagger-group">
      {
        fashionItems.map((item) => (
          <div class="col-12 col-sm-6 col-xl-3 d-flex">
            <article class="fashion-card flex-fill">
              <div class="fashion-card__media">
                <img
                  src={item.image}
                  alt={item.alt}
                  width="1024"
                  height="1536"
                  class="fashion-card__image"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="fashion-card__body">
                <h3 class="fashion-card__title">{item.title}</h3>
                <p class="fashion-card__caption">{item.caption}</p>
              </div>
            </article>
          </div>
        ))
      }
    </div>

    <div class="fashion-closing text-center reveal reveal-up">
      <p>Celebrate Ghanaian identity through timeless craftsmanship and contemporary expression.</p>
      <a href="#festival-program" class="btn ticket-button">EXPLORE THE FASHION SHOWCASE</a>
    </div>
  </div>
</section>

<style>
  .fashion-section {
    background-color: var(--color-white);
  }

  .fashion-header {
    max-width: 780px;
    margin-inline: auto;
    margin-bottom: 3.25rem;
  }

  .fashion-intro {
    color: var(--color-charcoal);
    font-size: 1.0625rem;
    line-height: 1.65;
    margin: 0.75rem auto 0;
  }

  .fashion-card {
    height: 100%;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 14px rgba(37, 37, 37, 0.05);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .fashion-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(37, 37, 37, 0.08);
  }

  .fashion-card__media {
    width: 100%;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 6px 6px 0 0;
    background: var(--color-ivory);
  }

  .fashion-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .fashion-card__body {
    padding: 1.25rem 1rem 1.35rem;
    text-align: center;
  }

  .fashion-card__title {
    color: var(--color-primary);
    font-family: "Georgia", "Cambria", "Times New Roman", serif;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 0.45rem;
  }

  .fashion-card__caption {
    color: var(--color-charcoal);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.4;
    margin: 0;
    text-transform: uppercase;
  }

  .fashion-closing {
    padding-top: 2.75rem;
  }

  .fashion-closing p {
    color: var(--color-charcoal);
    font-size: 1.0625rem;
    line-height: 1.6;
    margin: 0 auto 1.5rem;
  }
</style>
