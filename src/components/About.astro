<section id="about" class="about-section" aria-labelledby="about-heading">
  <div class="header-container">
    <header class="about-header text-center">
      <p class="section-eyebrow about-eyebrow reveal reveal-up">ABOUT GHANA DAY</p>
      <h2 id="about-heading" class="about-heading reveal reveal-up">
        <span>Sharing Ghana’s Heritage.</span>
        <span>Strengthening Community.</span>
      </h2>
    </header>

    <div class="row g-4 g-xl-5 align-items-stretch about-story-layout">
      <div class="col-12 col-lg-7 reveal reveal-left">
        <div class="about-image-wrapper">
          <img
            src="/images/exec.png"
            alt="Ghana Day organizers and community members gathered around a celebration cake"
            width="1086"
            height="1448"
            class="about-image"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <div class="col-12 col-lg-5 reveal reveal-right">
        <div class="about-story-panel">
          <p class="about-panel-label">OUR STORY</p>
          <div class="about-story-copy">
            <p>
              Ghana Day in Tampa Bay is a vibrant community celebration honoring Ghanaian culture, heritage and the contributions of Ghana and the African diaspora.
            </p>
            <p>
              Through music, food, fashion, history and the arts, the festival creates a welcoming place for people to connect, learn and celebrate together.
            </p>
            <p>
              Presented by the Ghanaian Association of Tampa Bay, Ghana Fest Florida 2026 promotes cultural awareness, unity and meaningful connections across Tampa Bay and beyond.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="about-purpose-section">
      <h3 class="about-subheading reveal reveal-up">WHY WE CELEBRATE</h3>
      <div class="row g-4 stagger-group">
        <div class="col-12 col-md-4">
          <article class="about-purpose-card">
            <div class="about-purpose-icon" aria-hidden="true"><i class="bi bi-bank"></i></div>
            <h4>Preserve Heritage</h4>
            <p>Honoring Ghanaian traditions, stories and cultural identity.</p>
          </article>
        </div>
        <div class="col-12 col-md-4">
          <article class="about-purpose-card">
            <div class="about-purpose-icon" aria-hidden="true"><i class="bi bi-people"></i></div>
            <h4>Connect Communities</h4>
            <p>Bringing Ghanaians, the African diaspora and the wider Tampa Bay community together.</p>
          </article>
        </div>
        <div class="col-12 col-md-4">
          <article class="about-purpose-card">
            <div class="about-purpose-icon" aria-hidden="true"><i class="bi bi-sunrise"></i></div>
            <h4>Inspire the Future</h4>
            <p>Helping younger generations experience and carry Ghanaian culture forward.</p>
          </article>
        </div>
      </div>
    </div>

  </div>
</section>
